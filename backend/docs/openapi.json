{
  "components": {
    "schemas": {
      "auth.apiError": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "auth.authResponse": {
        "properties": {
          "access_token": {
            "type": "string"
          },
          "expires_in": {
            "type": "integer"
          },
          "token_type": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/auth.userResponse"
          }
        },
        "type": "object"
      },
      "auth.credentials": {
        "properties": {
          "email": {
            "example": "user@example.com",
            "format": "email",
            "maxLength": 254,
            "type": "string"
          },
          "password": {
            "example": "password123",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "type": "object"
      },
      "auth.userResponse": {
        "properties": {
          "avatar_url": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "monitors.Input": {
        "properties": {
          "interval_minutes": {
            "example": 5,
            "maximum": 1440,
            "minimum": 1,
            "type": "integer"
          },
          "url": {
            "example": "https://example.com",
            "maxLength": 2048,
            "type": "string"
          }
        },
        "required": [
          "interval_minutes",
          "url"
        ],
        "type": "object"
      },
      "monitors.Monitor": {
        "properties": {
          "created_at": {
            "type": "string"
          },
          "id": {
            "type": "integer"
          },
          "interval_minutes": {
            "type": "integer"
          },
          "url": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "monitors.apiError": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Authentication, profiles and website monitors. JSON errors use error.code and error.message. Browser requests must use the configured CLIENT_ORIGIN.",
    "title": "Uptime App API",
    "version": "1.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Backend is ready."
          }
        },
        "summary": "Backend readiness",
        "tags": [
          "health"
        ]
      }
    },
    "/api/auth/avatars/{filename}": {
      "get": {
        "parameters": [
          {
            "description": "32 hexadecimal characters followed by .png",
            "in": "path",
            "name": "filename",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "image/png": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "OK",
            "headers": {
              "Cache-Control": {
                "description": "public, max-age=31536000, immutable",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/auth.apiError"
                }
              }
            },
            "description": "origin_not_allowed"
          },
          "404": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Avatar not found"
          }
        },
        "summary": "Get avatar",
        "tags": [
          "profile"
        ]
      }
    },
    "/api/auth/login": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/auth.credentials"
              }
            }
          },
          "description": "Valid email and password of 8 to 72 UTF-8 bytes; unknown fields rejected",
          "required": true,
          "x-originalParamName": "body"
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/auth.authResponse"
                }
              }
            },
            "description": "OK",
            "headers": {
              "Set-Cookie": {
                "description": "HttpOnly refresh_token; Path=/api/auth; SameSite=Lax; Max-Age=2592000",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/auth.apiError"
                }
              }
            },
            "description": "invalid_request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/auth.apiError"
                }
              }
            },
            "description": "invalid_credentials"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/auth.apiError"
                }
              }
            },
            "description": "origin_not_allowed"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/auth.apiError"
                }
              }
            },
            "description": "internal_error"
          }
        },
        "summary": "Log in",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/logout": {
      "post": {
        "parameters": [
          {
            "description": "refresh_token=\u003ctoken\u003e; logout also succeeds without a cookie",
            "in": "cookie",
            "name": "refresh_token",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Session revoked",
            "headers": {
              "Set-Cookie": {
                "description": "Clears refresh_token",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/auth.apiError"
                }
              }
            },
            "description": "origin_not_allowed"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/auth.apiError"
                }
              }
            },
            "description": "internal_error"
          }
        },
        "summary": "Log out",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/me": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/auth.userResponse"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/auth.apiError"
                }
              }
            },
            "description": "invalid_token"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/auth.apiError"
                }
              }
            },
            "description": "origin_not_allowed"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/auth.apiError"
                }
              }
            },
            "description": "internal_error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Get current user",
        "tags": [
          "profile"
        ]
      },
      "patch": {
        "description": "Send JSON with a required name, or multipart with exactly one PNG/JPEG avatar (up to 5 MiB and 16 megapixels) and an optional name. Names contain 1 to 100 characters after trimming. Omitting the multipart name preserves the current name.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "name": {
                    "maxLength": 100,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "name"
                ],
                "type": "object"
              }
            },
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "avatar": {
                    "description": "PNG or JPEG, up to 5 MiB and 16 megapixels",
                    "format": "binary",
                    "type": "string",
                    "x-formData-name": "avatar"
                  },
                  "name": {
                    "description": "Display name",
                    "maxLength": 100,
                    "minLength": 1,
                    "type": "string",
                    "x-formData-name": "name"
                  }
                },
                "required": [
                  "avatar"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/auth.userResponse"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/auth.apiError"
                }
              }
            },
            "description": "invalid_request or invalid_avatar"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/auth.apiError"
                }
              }
            },
            "description": "invalid_token"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/auth.apiError"
                }
              }
            },
            "description": "origin_not_allowed"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/auth.apiError"
                }
              }
            },
            "description": "avatar_too_large"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/auth.apiError"
                }
              }
            },
            "description": "internal_error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Update current profile",
        "tags": [
          "profile"
        ]
      }
    },
    "/api/auth/refresh": {
      "post": {
        "parameters": [
          {
            "description": "refresh_token=\u003ctoken\u003e; browsers send it with credentials included",
            "in": "cookie",
            "name": "refresh_token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/auth.authResponse"
                }
              }
            },
            "description": "OK",
            "headers": {
              "Set-Cookie": {
                "description": "HttpOnly refresh_token; Path=/api/auth; SameSite=Lax; Max-Age=2592000",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/auth.apiError"
                }
              }
            },
            "description": "invalid_token"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/auth.apiError"
                }
              }
            },
            "description": "origin_not_allowed"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/auth.apiError"
                }
              }
            },
            "description": "internal_error"
          }
        },
        "summary": "Rotate refresh token",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/register": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/auth.credentials"
              }
            }
          },
          "description": "Valid email and password of 8 to 72 UTF-8 bytes; unknown fields rejected",
          "required": true,
          "x-originalParamName": "body"
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/auth.authResponse"
                }
              }
            },
            "description": "Created",
            "headers": {
              "Set-Cookie": {
                "description": "HttpOnly refresh_token; Path=/api/auth; SameSite=Lax; Max-Age=2592000",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/auth.apiError"
                }
              }
            },
            "description": "invalid_request"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/auth.apiError"
                }
              }
            },
            "description": "origin_not_allowed"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/auth.apiError"
                }
              }
            },
            "description": "email_taken"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/auth.apiError"
                }
              }
            },
            "description": "internal_error"
          }
        },
        "summary": "Register user",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/monitors": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/monitors.Monitor"
                  },
                  "type": "array"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/monitors.apiError"
                }
              }
            },
            "description": "invalid_token"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/monitors.apiError"
                }
              }
            },
            "description": "origin_not_allowed"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/monitors.apiError"
                }
              }
            },
            "description": "internal_error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "List monitors",
        "tags": [
          "monitors"
        ]
      },
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/monitors.Input"
              }
            }
          },
          "description": "HTTP/HTTPS URL without credentials or fragment; interval 1 to 1440 minutes; unknown fields rejected",
          "required": true,
          "x-originalParamName": "body"
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/monitors.Monitor"
                }
              }
            },
            "description": "Created"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/monitors.apiError"
                }
              }
            },
            "description": "invalid_request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/monitors.apiError"
                }
              }
            },
            "description": "invalid_token"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/monitors.apiError"
                }
              }
            },
            "description": "origin_not_allowed"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/monitors.apiError"
                }
              }
            },
            "description": "internal_error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Create monitor",
        "tags": [
          "monitors"
        ]
      }
    }
  }
}
